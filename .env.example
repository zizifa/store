# Copy this file to .env and fill in real values.
# NEVER commit .env. Values here are placeholders only.
#
# SECURITY: set SECRET_KEY to a long random string in .env, e.g. generated via:
#   python3 -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'

# ---- Core Django ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Comma-separated allowed hosts. Empty/omitted -> localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
# Preferred: a single URL. Examples:
#   PostgreSQL:  postgresql://store:store_password@localhost:5432/store
#   SQLite:      sqlite:///db.sqlite3
# Leave unset to fall back to the DB_* variables or, if those are also unset,
# to a local SQLite file for zero-configuration development.
DATABASE_URL=

# Individual fallback variables (used only when DATABASE_URL is unset):
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---- Email ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=change-me-app-specific-password
